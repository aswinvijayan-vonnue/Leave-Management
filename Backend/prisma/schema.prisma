// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}
enum Role {
  employee
  manager
}
model User { 
  id    Int     @id @default(autoincrement()) 
  email String  @unique
  name  String?
  password String
  departmentId Int
  role Role @default(employee)
  leaveInfo LeaveBalance[]
  department Department @relation(references: [id],fields: [departmentId])
  leaveRequests LeaveRequestHistory[]
} 

model Department {
  id Int @id @default(autoincrement())
  name String @unique
  createdAt DateTime @default(now())
  employees User[]
}

model LeaveType {
  id Int @id @default(autoincrement())
  name String @unique @db.VarChar(50)
  
  leaveBalances LeaveBalance[]
  leaveRequest LeaveRequestHistory[]
}

model LeaveBalance{
  id Int @id @default(autoincrement())
  employeeId Int
  year Int
  leaveTypeId Int
  allocatedDays Int
  usedDays Int @default(0)

  leaveType LeaveType @relation(fields: [leaveTypeId],references: [id])
  employee User @relation(fields: [employeeId],references: [id])

  @@unique([employeeId,year,leaveTypeId])
}
enum Status {
  Approved
  Pending
  Rejected
}
model LeaveRequestHistory{
  id Int @id @default(autoincrement())
  employeeId Int 
  leaveTypeId Int
  from DateTime
  to DateTime
  status Status @default(Pending)
  reason String @db.VarChar(50)
  appliedOn DateTime @default(now())

  employee User @relation(fields: [employeeId],references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId],references: [id])
}